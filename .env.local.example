# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is gitignored — your real keys never end up in the repo.
# Never prefix secret keys with NEXT_PUBLIC_; that ships them to every browser.

# Supabase — project URL and publishable/anon key go in NEXT_PUBLIC_* (safe in browser).
# The service-role key is server-only — never expose it.
# Find these at https://supabase.com/dashboard/project/<ref>/settings/api-keys
#
# Set ONE of the two key variables — the code reads either. The new Supabase
# quickstart uses `NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY` (sb_publishable_…
# format). The legacy name is `NEXT_PUBLIC_SUPABASE_ANON_KEY` (JWT format).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=   # legacy — only set if not using PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — used by the Photo Processing module (background removal + car/backdrop image generation).
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
