# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is gitignored — your real keys never end up in the repo.
# Never prefix secret keys with NEXT_PUBLIC_; that ships them to every browser.

# Supabase — project URL and publishable/anon key go in NEXT_PUBLIC_* (safe in browser).
# The service-role key is server-only — never expose it.
# Find these at https://supabase.com/dashboard/project/<ref>/settings/api-keys
#
# Set ONE of the two key variables — the code reads either. The new Supabase
# quickstart uses `NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY` (sb_publishable_…
# format). The legacy name is `NEXT_PUBLIC_SUPABASE_ANON_KEY` (JWT format).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=   # legacy — only set if not using PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — used by the Photo Processing module (background removal + car/backdrop image generation).
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# DVLA Open Data — used by the Vehicle Enquiry Service lookup in the arrival
# form and dashboard Find-vehicle card. Free tier is rate-limited
# (5 req/sec, 1000 req/day). Register and get a key at
# https://register-for-vehicle-enquiry-service.driver-vehicle-licensing.api.gov.uk/
DVLA_API_KEY=

# DVSA MOT History API — OAuth 2.0 client-credentials against Microsoft Entra,
# called by /api/vehicle/lookup alongside the DVLA enquiry. Apply at
# https://documentation.history.mot.api.gov.uk/. The five values below are
# all required; missing any one degrades the combined lookup to DVLA-only
# (the route still returns 200 with motStatus / motExpiryDate = null).
DVSA_CLIENT_ID=
DVSA_CLIENT_SECRET=
DVSA_API_KEY=
DVSA_SCOPE_URL=https://tapi.dvsa.gov.uk/.default
DVSA_TOKEN_URL=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token

# AutoTrader Connect API — vehicle taxonomy + valuation enrichment on
# /api/vehicle/lookup, and stock publish from the Work List. KEY + SECRET
# are exchanged at POST {base}/authenticate for a ~15-min access token.
# ADVERTISER_ID scopes stock + lookup. SANDBOX=true uses api-sandbox.*;
# leave false/unset for production. Missing any value degrades the lookup
# gracefully (sources.autotrader = "missing_credentials").
AUTOTRADER_KEY=
AUTOTRADER_SECRET=
AUTOTRADER_ADVERTISER_ID=
AUTOTRADER_SANDBOX=true

# LLM gateway — powers the Advert tool's "Generate description" button
# (/api/listing/generate-description). Any OpenAI-compatible chat-completions
# endpoint works. The route reads LLM_API_KEY (falling back to OPENAI_API_KEY
# above), posts to `${LLM_BASE_URL}/chat/completions`, and uses LLM_MODEL.
# LLM_BASE_URL must be the endpoint BASE (the part before /chat/completions),
# e.g. https://gateway.example.com/v1 — NOT the key. If LLM_API_KEY/OPENAI_API_KEY
# is unset, the route returns a deterministic templated description instead.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
